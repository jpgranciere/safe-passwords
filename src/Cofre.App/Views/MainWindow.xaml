<ui:FluentWindow x:Class="Cofre.App.Views.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Cofre" Width="1240" Height="820" MinWidth="1040" MinHeight="720"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="DoNotRound"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource MainCanvasBrush}"
        Foreground="{DynamicResource MainInkBrush}" FontFamily="Segoe UI" FontSize="14"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <ui:FluentWindow.Resources>
        <Visibility x:Key="AccountMetadataVisibility">Visible</Visibility>
    </ui:FluentWindow.Resources>
    <Grid Background="{DynamicResource MainCanvasBrush}" TextElement.Foreground="{DynamicResource MainInkBrush}">
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource MainLineBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource MainSidebarBrush}">
            <ui:TitleBar x:Name="WindowTitleBar" Title="COFRE" Icon="/Assets/logo.png" ShowMinimize="True" ShowMaximize="True" ShowClose="True"
                         ForceShutdown="False" Foreground="{DynamicResource MainInkBrush}" ButtonsForeground="{DynamicResource MainInkBrush}"/>
        </Border>
        <Grid Grid.Row="1" x:Name="Workspace">
            <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*" MinWidth="330"/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource MainSidebarBrush}" BorderBrush="{DynamicResource MainLineBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,0">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Margin="16,30,0,24">
                            <TextBlock Text="NESTE DISPOSITIVO" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="Cofre pessoal" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                        <RadioButton x:Name="AllNav" GroupName="Navigation" Style="{StaticResource NavItem}" Tag="all" Click="OnFilter">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Key24" FontSize="17" Margin="0,0,12,0"/><TextBlock Text="Minhas contas"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="FavoritesNav" GroupName="Navigation" Style="{StaticResource NavItem}" Tag="favorites" Click="OnFilter">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Star24" FontSize="17" Margin="0,0,12,0"/><TextBlock Text="Favoritos"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TotpNav" GroupName="Navigation" Style="{StaticResource NavItem}" Tag="totp" Click="OnFilter">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Clock24" FontSize="17" Margin="0,0,12,0"/><TextBlock Text="Autenticador"/></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="SecurityNav" GroupName="Navigation" Style="{StaticResource NavItem}" Tag="security" Click="OnFilter">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Shield24" FontSize="17" Margin="0,0,12,0"/><TextBlock Text="Segurança"/></StackPanel>
                        </RadioButton>
                        <TextBlock Text="PASTAS" Style="{StaticResource Eyebrow}" Margin="16,32,0,10"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="8,18,8,22">
                        <Button Style="{StaticResource GhostButton}" Click="OnQuick" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,10">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Keyboard24" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="Painel rápido"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="OnExtension" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,10">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Globe24" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="Extensão"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Click="OnLock" HorizontalContentAlignment="Left" Padding="8,10">
                            <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="LockClosed24" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="Bloquear cofre"/></StackPanel>
                        </Button>
                    </StackPanel>
                    <ListBox x:Name="Folders" SelectionChanged="OnFolder" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource MainRow}" Padding="10,0" Foreground="{DynamicResource MainInkBrush}">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Padding="8,10" TextTrimming="CharacterEllipsis"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" Margin="28,28,28,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="Heading" Text="Minhas contas" FontSize="30" FontWeight="SemiBold" Margin="0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="NewButton" Style="{StaticResource PrimaryButton}" Content="+ Adicionar conta" Click="OnNew" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
                <TextBlock x:Name="Counts" Grid.Row="1" Foreground="{DynamicResource MainMutedBrush}" FontSize="12" Margin="0,12,0,24"/>
                <Border x:Name="AuditCard" Grid.Row="2" Background="{DynamicResource MainPanelBrush}" BorderBrush="{DynamicResource MainLineBrush}" BorderThickness="1" Padding="18" Margin="0,0,0,20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Saúde das senhas" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AuditSummary" TextWrapping="Wrap" Margin="0,12,0,12"/>
                        <TextBlock Text="Análise local de força e repetição. TOTP não cadastrado não significa ausência de 2FA no site. Não consulta vazamentos." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MainMutedBrush}"/>
                    </StackPanel>
                </Border>
                <ui:TextBox Grid.Row="3" x:Name="Search" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" PlaceholderText="Buscar contas, pastas ou tags" ToolTip="Buscar por nome, usuário, site, pasta ou tag" TextChanged="OnSearch" Margin="0,0,0,20" MinHeight="40"/>
                <Border Grid.Row="4" BorderBrush="{DynamicResource MainLineBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="CONTA" Style="{StaticResource Eyebrow}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{DynamicResource AccountMetadataVisibility}">
                            <TextBlock Text="SITE" Width="170" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="PASTA" Width="120" Style="{StaticResource Eyebrow}"/>
                            <TextBlock Text="ATUALIZADA EM" Width="90" Style="{StaticResource Eyebrow}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="5">
                    <ListBox x:Name="Entries" SelectionChanged="OnSelect" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource MainRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="18,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                <Border Width="34" Height="40" Background="{DynamicResource MainSelectedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <ui:SymbolIcon Grid.Column="1" Symbol="Star24" FontSize="12" Foreground="{DynamicResource BrandBrush}" Margin="8,0,0,0" Visibility="{Binding FavoriteVisibility}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Username}" FontSize="12" Foreground="{DynamicResource MainMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" Visibility="{Binding UsernameVisibility}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{DynamicResource AccountMetadataVisibility}">
                                    <TextBlock Text="{Binding SiteLabel}" Width="170" Padding="0,0,14,0" FontSize="12" Foreground="{DynamicResource MainMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FolderLabel}" Width="120" Padding="0,0,14,0" FontSize="12" Foreground="{DynamicResource MainMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding UpdatedLabel}" Width="90" FontSize="12" Foreground="{DynamicResource MainMutedBrush}"/>
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="3" Symbol="ChevronRight24" FontSize="14" Foreground="{DynamicResource MainMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="12">
                        <ui:SymbolIcon Symbol="Key24" FontSize="30" Foreground="{DynamicResource MainMutedBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nenhuma conta por aqui" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,8"/>
                        <TextBlock Text="Adicione uma conta ou ajuste a busca." FontSize="12" TextAlignment="Center" Foreground="{DynamicResource MainMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="6" x:Name="CollectionTip" BorderBrush="{DynamicResource MainLineBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Cursor24" FontSize="16" Foreground="{DynamicResource BrandBrush}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                        <TextBlock Grid.Column="1" Text="Selecione uma conta para ver os detalhes. Suas senhas ficam ocultas até você pedir para exibi-las." FontSize="12" Foreground="{DynamicResource MainMutedBrush}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Column="2" x:Name="DetailsPane" Visibility="Collapsed" Background="{DynamicResource MainPanelBrush}" BorderBrush="{DynamicResource MainLineBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="26,28,26,22">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetailsCaption" Text="DETALHES DA CONTA" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="EditButton" Style="{StaticResource GhostButton}" Click="OnEdit" Padding="10,7" Margin="8,0,8,0"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Edit24" FontSize="15" Margin="0,0,7,0"/><TextBlock Text="Editar"/></StackPanel></Button>
                            <Button Grid.Column="2" x:Name="CloseDetailsButton" Style="{StaticResource IconAction}" Click="OnCloseDetails" ToolTip="Fechar detalhes (Esc)" AutomationProperties.Name="Fechar detalhes" Padding="7">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16"/>
                            </Button>
                        </Grid>
                        <StackPanel x:Name="EditorActions" DockPanel.Dock="Bottom" Margin="0,18,0,0" Visibility="Collapsed">
                            <Border Height="1" Background="{DynamicResource MainLineBrush}" Margin="0,0,0,14"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="SaveButton" Content="Salvar" Style="{StaticResource PrimaryButton}" Click="OnSave" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" x:Name="CancelButton" Content="Cancelar" Style="{StaticResource GhostButton}" Click="OnDiscard" Margin="0,0,8,0"/>
                                <Button Grid.Column="2" Content="Excluir" x:Name="DeleteButton" Style="{StaticResource GhostButton}" Foreground="{DynamicResource MainDangerBrush}" Click="OnDelete"/>
                            </Grid>
                        </StackPanel>
                        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                            <Grid>
                                <StackPanel x:Name="ReadPanel">
                                    <TextBlock x:Name="SummaryTitle" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                    <TextBlock x:Name="SummaryMeta" Foreground="{DynamicResource MainMutedBrush}" FontSize="13"/>
                                    <Border Height="1" Background="{DynamicResource MainLineBrush}" Margin="0,24,0,0"/>
                                    <Grid Margin="0,24,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="USUÁRIO / E-MAIL" Style="{StaticResource Eyebrow}" Margin="0,0,0,9"/>
                                            <TextBlock x:Name="SummaryUser" Style="{StaticResource DetailValue}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="CopyUserButton" Style="{StaticResource IconAction}" Click="OnCopyUser" VerticalAlignment="Bottom"
                                                ToolTip="Copiar usuário" AutomationProperties.Name="Copiar usuário"><ui:SymbolIcon Symbol="Copy24" FontSize="17"/></Button>
                                    </Grid>
                                    <TextBlock Text="SENHA" Style="{StaticResource DetailLabel}" Margin="0,24,0,9"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SummaryPassword" Text="••••••••••••" FontFamily="Consolas" FontSize="21" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <Button Grid.Column="1" x:Name="RevealButton" Style="{StaticResource IconAction}" Click="OnReveal" ToolTip="Exibir senha" AutomationProperties.Name="Exibir ou ocultar senha">
                                            <ui:SymbolIcon x:Name="RevealIcon" Symbol="Eye24" FontSize="18"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="SummaryStrength" Foreground="{DynamicResource MainMutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                                    <Button x:Name="CopyPasswordButton" Style="{StaticResource PrimaryButton}" Click="OnCopyPassword" HorizontalAlignment="Left" Margin="0,18,0,0">
                                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Copy24" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="Copiar senha"/></StackPanel>
                                    </Button>
                                    <Border x:Name="TotpCard" BorderBrush="{DynamicResource MainLineBrush}" BorderThickness="0,1,0,0" Padding="0,22,0,0" Margin="0,26,0,0" Visibility="Collapsed">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="CÓDIGO DE VERIFICAÇÃO" Style="{StaticResource Eyebrow}"/>
                                                <TextBlock x:Name="TotpCode" FontSize="30" FontFamily="Consolas" Foreground="{DynamicResource BrandBrush}" Margin="0,10,0,4"/>
                                                <TextBlock x:Name="TotpTime" Foreground="{DynamicResource MainMutedBrush}" FontSize="12"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="CopyTotpButton" Style="{StaticResource IconAction}" Click="OnCopyTotp" VerticalAlignment="Center"
                                                    ToolTip="Copiar código" AutomationProperties.Name="Copiar código"><ui:SymbolIcon Symbol="Copy24" FontSize="17"/></Button>
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="{DynamicResource MainLineBrush}" Margin="0,26,0,0"/>
                                    <Grid Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="SITE" Style="{StaticResource Eyebrow}" Margin="0,0,0,9"/>
                                            <TextBlock x:Name="SummarySite" Style="{StaticResource DetailValue}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" x:Name="OpenSiteButton" Style="{StaticResource IconAction}" Click="OnOpenSite" VerticalAlignment="Bottom"
                                                ToolTip="Abrir site" AutomationProperties.Name="Abrir site"><ui:SymbolIcon Symbol="Open24" FontSize="17"/></Button>
                                    </Grid>
                                    <TextBlock Text="ORGANIZAÇÃO" Style="{StaticResource DetailLabel}" Margin="0,26,0,9"/>
                                    <TextBlock x:Name="SummaryOrganization" FontSize="13" Foreground="{DynamicResource MainMutedBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="NOTAS" Style="{StaticResource DetailLabel}" Margin="0,24,0,9"/>
                                    <TextBlock x:Name="SummaryNotes" FontSize="13" Foreground="{DynamicResource MainMutedBrush}" TextWrapping="Wrap" LineHeight="21"/>
                                    <TextBlock x:Name="SummaryFinding" Foreground="{DynamicResource MainDangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,22,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="Editor" Visibility="Collapsed">
                                    <TextBlock Text="EDITAR INFORMAÇÕES" Style="{StaticResource Eyebrow}"/>
                                    <TextBlock x:Name="EditorHeading" Text="Editar conta" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,12"/>
                                    <TextBlock Text="Nome da conta" Style="{StaticResource FieldLabel}"/><ui:TextBox x:Name="TitleInput" MaxLength="200" PlaceholderText="Ex.: E-mail pessoal"/>
                                    <TextBlock Text="Usuário / e-mail" Style="{StaticResource FieldLabel}"/><ui:TextBox x:Name="UserInput" MaxLength="1000"/>
                                    <TextBlock Text="Senha" Style="{StaticResource FieldLabel}"/>
                                    <ui:PasswordBox x:Name="PasswordInput" MinHeight="36" PasswordChanged="OnPasswordChanged"/>
                                    <TextBlock x:Name="StrengthText" Style="{StaticResource MutedText}" Margin="0,6,0,10"/>
                                    <Button Content="Gerar senha" Style="{StaticResource GhostButton}" Click="OnGenerate" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Endereço do site" Style="{StaticResource FieldLabel}"/><ui:TextBox x:Name="UrlInput" MaxLength="2048" PlaceholderText="https://exemplo.com"/>
                                    <TextBlock Text="Pasta" Style="{StaticResource FieldLabel}"/><ui:TextBox x:Name="FolderInput" MaxLength="100"/>
                                    <TextBlock Text="Tags (separadas por vírgulas)" Style="{StaticResource FieldLabel}"/><ui:TextBox x:Name="TagsInput" MaxLength="500"/>
                                    <CheckBox x:Name="FavoriteInput" Content="Favorito" Margin="0,18,0,0"/>
                                    <TextBlock Text="Notas" Style="{StaticResource FieldLabel}"/><ui:TextBox x:Name="NotesInput" AcceptsReturn="True" TextWrapping="Wrap" Height="85" VerticalScrollBarVisibility="Auto"/>
                                    <TextBlock Text="CÓDIGO DE VERIFICAÇÃO — 2FA" Style="{StaticResource Eyebrow}" Margin="0,24,0,10"/>
                                    <TextBlock Text="Chave Base32 ou endereço otpauth://totp do serviço. A chave será criptografada no cofre." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MainMutedBrush}" Margin="0,0,0,10"/>
                                    <ui:PasswordBox x:Name="TotpInput" MinHeight="36" MaxLength="4096" PasswordChanged="OnTotpChanged"/>
                                    <TextBlock x:Name="FindingText" Foreground="{DynamicResource MainDangerBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                    <StackPanel x:Name="NoSelection" VerticalAlignment="Center" Margin="16" Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="32" Foreground="{DynamicResource MainMutedBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Tudo no seu lugar." FontSize="23" FontWeight="SemiBold" Margin="0,20,0,10"/>
                        <TextBlock Text="Selecione uma conta para consultar os detalhes ou adicione uma nova." TextWrapping="Wrap" Foreground="{DynamicResource MainMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="1" x:Name="LockedOverlay" Background="{DynamicResource MainCanvasBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                <ui:SymbolIcon Symbol="ShieldLock24" FontSize="40" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Seu cofre está protegido." FontSize="28" FontWeight="SemiBold" TextAlignment="Center" Margin="0,24,0,0"/>
                <TextBlock Text="Desbloqueie para acessar suas contas e códigos de verificação." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MainMutedBrush}" Margin="0,14,0,26"/>
                <Button Content="Desbloquear cofre" Style="{StaticResource PrimaryButton}" Click="OnQuick" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" BorderBrush="{DynamicResource MainLineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource MainSidebarBrush}">
            <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="LOCAL · CRIPTOGRAFADO" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="Status" FontSize="12" Margin="24,0,20,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrandBrush}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                <TextBlock Grid.Column="2" Text="COFRE / 1.3.1" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Popup x:Name="CopyFeedback" Placement="Bottom" VerticalOffset="7" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource MainInkBrush}" Padding="12,9" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="14" Foreground="{DynamicResource MainCanvasBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="CopyFeedbackText" FontSize="12" Foreground="{DynamicResource MainCanvasBrush}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>
