<ui:FluentWindow x:Class="Cofre.App.Views.AppDialogWindow" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner" WindowStyle="None" ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None" WindowCornerPreference="DoNotRound"
    Background="{DynamicResource MainPanelBrush}" Foreground="{DynamicResource MainInkBrush}"
    FontFamily="Segoe UI" FontSize="14" KeyboardNavigation.TabNavigation="Cycle"
    SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Border Background="{DynamicResource MainPanelBrush}" BorderBrush="{DynamicResource MainLineBrush}" BorderThickness="1" Padding="30">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="DialogIcon" Symbol="Shield24" FontSize="20" Foreground="{DynamicResource BrandBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="COFRE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="DismissButton" Grid.Column="1" Style="{StaticResource IconAction}" Click="OnCancel"
                        ToolTip="Fechar (Esc)" AutomationProperties.Name="Fechar diálogo">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="18"/>
                </Button>
            </Grid>
            <TextBlock x:Name="DialogTitle" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="DialogMessage" Foreground="{DynamicResource MainMutedBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="23" Margin="0,14,0,0"/>
            <Border x:Name="ContextBox" Background="{DynamicResource MainCanvasBrush}" BorderBrush="{DynamicResource MainLineBrush}" BorderThickness="0,0,0,1" Padding="14" Margin="0,22,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ContextText" FontSize="14" TextWrapping="Wrap" LineHeight="23"/>
            </Border>
            <ContentControl x:Name="ExtraHost" Margin="0,22,0,0" Visibility="Collapsed" IsTabStop="False"/>
            <Border Height="1" Background="{DynamicResource MainLineBrush}" Margin="0,28,0,20"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="CancelAction" Style="{StaticResource GhostButton}" Content="Cancelar" IsCancel="True" IsDefault="True" Click="OnCancel" Margin="0,0,10,0"/>
                <Button x:Name="ConfirmAction" Style="{StaticResource PrimaryButton}" Content="Confirmar" Click="OnConfirm"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</ui:FluentWindow>
