<UserControl x:Class="Cofre.App.Views.UnlockView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="32,0">
        <StackPanel VerticalAlignment="Center">
            <Image Source="/Assets/logo.png" Width="84" Height="84"
                   RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" />
            <TextBlock Text="Cofre bloqueado" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,18,0,4" />
            <TextBlock Text="Digite sua senha mestra para continuar" Style="{StaticResource MutedText}"
                       TextAlignment="Center" FontSize="13" />

            <ui:PasswordBox x:Name="PasswordInput" PlaceholderText="Senha mestra" Margin="0,26,0,0">
                <ui:PasswordBox.RenderTransform>
                    <TranslateTransform x:Name="Shake" />
                </ui:PasswordBox.RenderTransform>
            </ui:PasswordBox>

            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="2,10,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

            <ui:Button x:Name="UnlockButton" Content="Desbloquear" Appearance="Primary"
                       HorizontalAlignment="Stretch" Margin="0,14,0,0" Padding="0,10"
                       Icon="{ui:SymbolIcon LockOpen24}" Click="OnUnlock" />
        </StackPanel>

        <TextBlock x:Name="HintText" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
                   Style="{StaticResource MutedText}" />
    </Grid>
</UserControl>
