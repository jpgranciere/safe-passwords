<UserControl x:Class="Cofre.App.Views.ChangePasswordView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:Cofre.App.Controls">
    <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8">
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Left" ToolTip="Voltar (Esc)" Click="OnBack">
                <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="18" />
            </Button>
            <TextBlock Text="Alterar senha mestra" Style="{StaticResource ViewTitle}" HorizontalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="4,0,8,0">
            <StackPanel>
                <TextBlock Text="Senha mestra atual" Style="{StaticResource FieldLabel}" Margin="2,4,0,5" />
                <ui:PasswordBox x:Name="CurrentInput" PlaceholderText="Senha atual" />

                <TextBlock Text="Nova senha mestra" Style="{StaticResource FieldLabel}" Margin="2,18,0,5" />
                <ui:PasswordBox x:Name="NewInput" PlaceholderText="Pelo menos 10 caracteres" PasswordChanged="OnNewChanged" />
                <controls:StrengthBar x:Name="Strength" Margin="0,8,0,0" />

                <TextBlock Text="Confirmar nova senha" Style="{StaticResource FieldLabel}" />
                <ui:PasswordBox x:Name="ConfirmInput" PlaceholderText="Digite novamente" />

                <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="2,10,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

                <ui:Button x:Name="SaveButton" Content="Alterar senha mestra" Appearance="Primary"
                           HorizontalAlignment="Stretch" Margin="0,18,0,0" Padding="0,10" Click="OnSave" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
