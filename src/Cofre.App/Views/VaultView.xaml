<UserControl x:Class="Cofre.App.Views.VaultView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Cofre.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:HeaderRow}">
            <TextBlock Text="{Binding Text}" Style="{StaticResource SectionHeader}" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EntryRow}">
            <Grid MinHeight="42">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="38" Height="38" CornerRadius="19" Background="{Binding AvatarBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                        <ui:SymbolIcon Symbol="Star24" Filled="True" FontSize="13" Margin="6,2,0,0"
                                       Foreground="#FBBF24" Visibility="{Binding FavoriteVisibility}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Username}" Visibility="{Binding UsernameVisibility}"
                               Style="{StaticResource MutedText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Copiar usuário" Click="OnCopyUser">
                        <ui:SymbolIcon Symbol="Person24" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Copiar senha" Click="OnCopyPassword">
                        <ui:SymbolIcon Symbol="Key24" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Digitar na janela anterior (Enter)" Click="OnAutoFill">
                        <ui:SymbolIcon Symbol="Keyboard24" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Editar" Click="OnEdit">
                        <ui:SymbolIcon Symbol="Edit24" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="14,14,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBox x:Name="Search" PlaceholderText="Buscar senhas" ClearButtonEnabled="True"
                    Icon="{ui:SymbolIcon Search24}" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown" />

        <Grid Grid.Row="1" Margin="0,10,0,8">
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource EntryRowStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnRowDoubleClick" />

            <StackPanel x:Name="EmptyVault" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="44" HorizontalAlignment="Center"
                               Foreground="{DynamicResource BrandBrush}" />
                <TextBlock Text="Seu cofre está vazio" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Adicione sua primeira senha para começar." Style="{StaticResource MutedText}"
                           TextAlignment="Center" />
                <ui:Button Content="Adicionar senha" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" Click="OnNew" />
            </StackPanel>

            <StackPanel x:Name="NoResults" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <ui:SymbolIcon Symbol="Search24" FontSize="34" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Nada encontrado" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,10,0,2" />
                <TextBlock Text="Tente outro termo de busca." Style="{StaticResource MutedText}" TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <ui:Button Content="Nova senha" Appearance="Primary" Icon="{ui:SymbolIcon Add24}"
                       HorizontalAlignment="Left" Click="OnNew" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButton}" ToolTip="Gerador de senhas" Click="OnGenerator">
                    <ui:SymbolIcon Symbol="Password24" FontSize="18" />
                </Button>
                <Button Style="{StaticResource IconButton}" ToolTip="Configurações" Click="OnSettings">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="18" />
                </Button>
                <Button Style="{StaticResource IconButton}" ToolTip="Bloquear agora" Click="OnLock">
                    <ui:SymbolIcon Symbol="LockClosed24" FontSize="18" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
