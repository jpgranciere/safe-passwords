<ui:FluentWindow x:Class="Cofre.App.Views.PopupWindow" x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Cofre"
                 Width="392" Height="584"
                 MinWidth="392" MinHeight="584"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 WindowStartupLocation="Manual"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="DoNotRound"
                 Background="{DynamicResource MainPanelBrush}">
    <Grid TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <ContentControl x:Name="Host" IsTabStop="False" />

        <!-- Snackbar: same dark pill in light and dark themes so it always reads clearly. -->
        <Border x:Name="ToastBorder"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="16,0,16,78" Padding="14,9"
                CornerRadius="0" Opacity="0" IsHitTestVisible="False"
                Background="#F2242430" BorderBrush="#33FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon x:Name="ToastIcon" Symbol="CheckmarkCircle24" FontSize="16" Foreground="#4ADE80" VerticalAlignment="Center" />
                <TextBlock x:Name="ToastText" Margin="9,0,0,0" Foreground="White" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="290" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
