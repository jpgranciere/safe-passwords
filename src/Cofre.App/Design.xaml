<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusSmall">0</CornerRadius>
    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}"><Setter Property="CornerRadius" Value="0"/></Style>
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource MainInkBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MainLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MainAccentInkBrush}"/>
    </Style>
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource MainMutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="15,13"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="NavigationBorder" Background="{TemplateBinding Background}">
                <Grid><Border x:Name="Indicator" Width="2" HorizontalAlignment="Left" Background="Transparent"/><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource MainHoverBrush}"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="NavigationBorder" Property="Background" Value="{DynamicResource MainSelectedBrush}"/>
                    <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource BrandBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MainInkBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Indicator" Property="Background" Value="{DynamicResource BrandBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MainRow" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource MainInkBrush}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MainLineBrush}">
                <Grid><Border x:Name="Marker" Width="2" HorizontalAlignment="Left" Background="Transparent"/><ContentPresenter/></Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource MainHoverBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource MainSelectedBrush}"/>
                    <Setter TargetName="Marker" Property="Background" Value="{DynamicResource BrandBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource MainMutedBrush}"/>
    </Style>
    <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}"><Setter Property="Margin" Value="0,22,0,7"/></Style>
    <Style x:Key="DetailValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/><Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource MainInkBrush}"/>
    </Style>
</ResourceDictionary>
