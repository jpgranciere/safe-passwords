{
  "manifest_version": 3,
  "name": "Cofre — Senhas locais",
  "version": "1.3.1",
  "description": "Senhas locais com sugestões nos campos, gerador e preenchimento de login. Integrado ao Cofre para Windows.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cofre",
    "default_icon": {
      "32": "icons/cofre-32.png",
      "16": "icons/cofre-16.png",
      "48": "icons/cofre-48.png",
      "128": "icons/cofre-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "32": "icons/cofre-32.png",
    "16": "icons/cofre-16.png",
    "48": "icons/cofre-48.png",
    "128": "icons/cofre-128.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
