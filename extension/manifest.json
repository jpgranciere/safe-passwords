{
  "manifest_version": 3,
  "name": "Cofre — Senhas locais",
  "version": "1.2.0",
  "description": "Preencha e salve logins HTTPS com seu Cofre para Windows. Sem nuvem.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Cofre" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
